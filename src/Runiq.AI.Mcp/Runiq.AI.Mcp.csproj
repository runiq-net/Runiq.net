<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Runiq.AI.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Title>Runiq Agents</Title>
    <Description>Expose ASP.NET Core application services as Model Context Protocol tools.</Description>
    <PackageTags>runiq;mcp;model-context-protocol;aspnetcore;ai-agents</PackageTags>
    <RepositoryUrl>https://github.com/runiq-net/Runiq.AI.git</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>Runiq.AI.Mcp</AssemblyName>
    <RootNamespace>Runiq.AI.Mcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\nuget\runiq-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
    <Folder Include="Tools\" />
  </ItemGroup>
</Project>