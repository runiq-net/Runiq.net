<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Runiq.AI.Rag</PackageId>
    <Version>1.0.0</Version>
    <Title>Runiq RAG</Title>
    <Authors>Runiq</Authors>
    <Company>Runiq</Company>
    <Description>Retrieval-augmented generation primitives for Runiq AI agents.</Description>
    <PackageTags>ai;agents;rag;retrieval;embeddings;dotnet;runiq</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Runiq.AI.Rag</AssemblyName>
    <RootNamespace>Runiq.AI.Rag</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\nuget\runiq-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <ProjectReference Include="..\Runiq.AI.Core\Runiq.AI.Core.csproj" />
  </ItemGroup>
</Project>
